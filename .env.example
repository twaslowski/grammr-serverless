# Copy to .env.local and fill in. All values below are required for `pnpm build`.

# PostgreSQL connection string used by Drizzle (src/db/connect.ts) and drizzle-kit.
# Points at the Supabase transaction pooler in deployed environments; prepared
# statements are disabled accordingly.
# Local default (via `task start-env`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase — used for authentication and session handling only.
# Data access goes through Drizzle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the deployed app.
NEXT_PUBLIC_APPLICATION_URL=http://localhost:3000

# AWS API Gateway fronting the NLP Lambdas (morphology, inflections,
# translate, tts). Provisioned by terraform/application.
# If unset, the routes in src/app/api that proxy to it return 503.
API_GW_URL=
API_GW_API_KEY=
